{
  "dataset": ["mnist", "mscoco"],
  "mnist": ["cnn"],
  "mscoco": ["clip"],
  "all_hyperparameters": {
    "mnist": [
      {
        "name": "learning_rate",
        "displayName": "lr",
        "type": "ordinal",
        "values": [1e-4, 1e-3, 1e-2, 1e-1],
        "range": [1e-4, 1e-1],
        "log": true
      },
      {
        "name": "optimizer",
        "displayName": "optim",
        "type": "unordered",
        "values": ["adam", "sgd", "rms"]
      },
      {
        "name": "scheduler_p",
        "displayName": "sche_p",
        "type": "unordered",
        "values": [false, true]
      },
      {
        "name": "batch_size",
        "displayName": "bs",
        "type": "ordinal",
        "values": [8, 16, 32],
        "range": [16, 64]
      },
      {
        "name": "weight_decay",
        "displayName": "wd",
        "type": "uniform",
        "values": [1e-4, 1e-3, 1e-2, 1e-1],
        "range": [0, 1e-3]
      },
      {
        "name": "momentum",
        "displayName": "mmt",
        "type": "uniform",
        "values": [0.9, 0.95, 0.99],
        "range": [0, 1]
      },
      {
        "name": "activation",
        "displayName": "acti",
        "type": "unordered",
        "values": ["relu", "lrelu", "tanh"]
      },
      {
        "name": "hidden_size",
        "displayName": "hs",
        "type": "ordinal",
        "values": [16, 32, 64],
        "range": [16, 64]
      }
    ],

    "mscoco": [
      {
        "name": "learning_rate",
        "displayName": "lr",
        "type": "ordinal",
        "values": [1e-5, 5e-5, 1e-4, 5e-4, 1e-3],
        "range": [1e-5, 1e-3],
        "log": true
      },
      {
        "name": "batch_size",
        "displayName": "bs",
        "type": "ordinal",
        "values": [16, 32, 64, 128],
        "range": [16, 128]
      },
      {
        "name": "eps",
        "displayName": "eps",
        "type": "ordinal",
        "values": [1e-8, 1e-7, 1e-6],
        "range": [1e-8, 1e-6],
        "log": true
      },
      {
        "name": "weight_decay",
        "displayName": "wd",
        "type": "uniform",
        "values": [0.0, 0.01, 0.1, 0.2],
        "range": [0.0, 0.3]
      },
      {
        "name": "optimizer_type",
        "displayName": "optim",
        "type": "unordered",
        "values": ["AdamW", "Adam", "SGD", "RMSprop", "Adagrad"]
      },
      {
        "name": "warmup_ratio",
        "displayName": "warmup",
        "type": "uniform",
        "values": [0.1, 0.2, 0.3],
        "range": [0.05, 0.4]
      },
      {
        "name": "scheduler_type",
        "displayName": "sched",
        "type": "unordered",
        "values": ["cosine", "cosine_restarts", "linear", "none"]
      },
      {
        "name": "dropout_rate",
        "displayName": "dropout",
        "type": "uniform",
        "values": [0.0, 0.1, 0.2, 0.3],
        "range": [0.0, 0.5]
      },
      {
        "name": "temperature_init",
        "displayName": "temp",
        "type": "uniform",
        "values": [0.07, 0.1, 0.2],
        "range": [0.01, 0.5]
      }
    ]
  },

  "dataset_model": {
    "mnist": ["cnn"],
    "mscoco": ["clip"]
  },
  "model_config": {
    "cnn": {
      "metric": {
        "name": "Accuracy",
        "range": [0, 1]
      },
      "hyperparameters": [
        "hidden_size",
        "learning_rate",
        "optimizer",
        "activation",
        "scheduler_p",
        "batch_size",
        "weight_decay",
        "momentum"
      ]
    },

    "clip": {
      "metric": {
        "name": "Retrieval Score",
        "range": [0, 100]
      },
      "hyperparameters": [
        "learning_rate",
        "batch_size",
        "eps",
        "weight_decay",
        "optimizer_type",
        "warmup_ratio",
        "scheduler_type",
        "dropout_rate",
        "temperature_init"
      ]
    }
  }
}
