{
  "name": "Bert",
  "model": "bert",
  "dataset": "K-MHaS",
  "hyperparameters": [
    {
      "name": "learning_rate",
      "displayName": "lr",
      "type": "ordinal",
      "values": [1e-4, 1e-3, 1e-2, 1e-1],
      "range": [1e-4, 1e-1],
      "log": true
    },
    {
      "name": "optimizer",
      "displayName": "optim",
      "type": "unordered",
      "values": [
        "adam",
        "adamw",
        "adafactor",
        "adamax",
        "asgd",
        "rprop",
        "nadam",
        "radam",
        "sgd",
        "rms"
      ]
    },
    {
      "name": "scheduler",
      "displayName": "sche",
      "type": "unordered",
      "values": [
        "const",
        "const_warmup",
        "cos_warmup",
        "cos_hard",
        "linear_warmup",
        "poly_decay",
        "none"
      ]
    },
    {
      "name": "batch_size",
      "displayName": "bs",
      "type": "ordinal",
      "values": [32, 64, 128],
      "range": [32, 256],
      "max": 128
    },
    {
      "name": "weight_decay",
      "displayName": "wd",
      "type": "uniform",
      "values": [1e-4, 1e-3, 1e-2, 1e-1],
      "range": [0, 1e-3]
    },
    {
      "name": "momentum",
      "displayName": "mmt",
      "type": "uniform",
      "values": [0.9, 0.95, 0.99],
      "range": [0, 1]
    },
    {
      "name": "activation",
      "displayName": "acti",
      "type": "unordered",
      "values": ["gelu", "relu", "silu", "gelu_new"]
    },
    {
      "name": "positional_embedding",
      "displayName": "pos_emb",
      "type": "unordered",
      "values": ["absolute", "relative_key", "relative_key_query"]
    },
    {
      "name": "dropout_probability",
      "displayName": "drop_p",
      "type": "ordinal",
      "values": [0.1, 0.3, 0.5],
      "range": [0, 0.5]
    },
    {
      "name": "classifier_dropout",
      "displayName": "cls_drop",
      "type": "uniform",
      "values": [0.1, 0.2, 0.3],
      "range": [0, 0.1]
    }
  ],
  "bohb": {
    "max_budget": 27,
    "eta": 3,
    "min_budget": 1
  },
  "metric": {
    "name": "Accuracy",
    "range": [0, 1]
  }
}
