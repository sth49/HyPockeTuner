{
  "name": "",
  "model": "cnn",
  "dataset": "mnist",
  "hyperparameters": [
    {
      "name": "batch_size",
      "displayName": "bs",
      "type": "ordinal",
      "values": [32, 64, 128],
      "range": [16, 64]
    },
    {
      "name": "optimizer",
      "displayName": "optim",
      "type": "unordered",
      "values": ["adam", "sgd", "rms"]
    },
    {
      "name": "learning_rate",
      "displayName": "lr",
      "type": "ordinal",
      "values": [1e-4, 1e-3, 1e-2, 1e-1],
      "range": [1e-4, 1e-1],
      "log": true
    },
    {
      "name": "weight_decay",
      "displayName": "wd",
      "type": "uniform",
      "values": [1e-4, 1e-3, 1e-2, 1e-1],
      "range": [0, 1e-3]
    },

    {
      "name": "scheduler_p",
      "displayName": "sche_p",
      "type": "unordered",
      "values": [false, true]
    },

    {
      "name": "momentum",
      "displayName": "mmt",
      "type": "uniform",
      "values": [0.9, 0.95, 0.99],
      "range": [0, 1]
    },
    {
      "name": "activation",
      "displayName": "acti",
      "type": "unordered",
      "values": ["relu", "lrelu", "tanh"]
    },
    {
      "name": "hidden_size",
      "displayName": "hs",
      "type": "ordinal",
      "values": [16, 32, 64],
      "range": [16, 64]
    }
  ],
  "bohb": {
    "max_budget": 81,
    "eta": 3,
    "min_budget": 1
  },
  "metric": {
    "name": "Accuracy",
    "range": [0, 1]
  }
}
